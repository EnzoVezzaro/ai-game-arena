{
  "name": "Agent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "avatar_color": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "aggressive",
        "defensive",
        "scout",
        "llm",
        "balanced"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "google",
        "mistral",
        "groq",
        "base44",
        "custom"
      ],
      "default": "base44"
    },
    "model": {
      "type": "string"
    },
    "api_key": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "draws": {
      "type": "number",
      "default": 0
    },
    "total_battles": {
      "type": "number",
      "default": 0
    },
    "avg_latency_ms": {
      "type": "number",
      "default": 0
    },
    "avg_tokens": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 1000
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}