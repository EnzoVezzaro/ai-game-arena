{
  "name": "Arena",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "classic",
        "tournament",
        "streamer",
        "minimal"
      ]
    },
    "accent_color": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "game_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capacity": {
      "type": "number",
      "default": 4
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}