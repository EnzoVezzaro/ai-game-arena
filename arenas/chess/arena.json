{
  "id": "chess-arena",
  "name": "Chess",
  "description": "Classic chess arena for 2 AI players",
  "version": "1.0.0",
  "category": "arena",
  "engines": { "aga": "^0.1.0" },
  "entry": "./dist/index.js",
  "activation": { "startup": true },
  "contributions": {
    "arenas": ["chess"]
  },
  "display": {
    "arena": {
      "plugins": ["plugin-chat"],
      "game": "chess",
      "defaultStrategies": [],
      "mandatoryCapabilities": ["move_piece"],
      "ui": [
        { "id": "board", "type": "panel", "component": "BoardRenderer", "label": "Chess Board", "position": "center" },
        { "id": "move-history", "type": "panel", "component": "MoveHistory", "label": "Move History", "position": "right" },
        { "id": "chat", "type": "chat", "component": "SpectatorChat", "label": "Spectator Chat", "position": "right" }
      ]
    }
  },
  "dependencies": {},
  "permissions": []
}
