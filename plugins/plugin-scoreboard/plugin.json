{
  "id": "plugin-scoreboard",
  "name": "Scoreboard",
  "version": "0.1.0",
  "description": "Tracks battle scores and a leaderboard with extended db storage",
  "author": "AI Game Arena",
  "category": "metric",
  "engines": { "aga": "^0.1.0" },
  "entry": "./dist/index.js",
  "activation": { "startup": true },
  "dependencies": {},
  "contributions": {
    "eventHandlers": ["ScoreUpdated", "BattleFinished"],
    "serverRoutes": ["/api/scoreboard/battles/:battleId", "/api/scoreboard/leaderboard"]
  }
}
